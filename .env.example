# ── Banco ──────────────────────────────────────────────
DATABASE_URL=postgres://orbita:orbita@localhost:5433/orbita

# ── Better Auth ────────────────────────────────────────
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-de-32+chars
BETTER_AUTH_URL=http://localhost:3000

# ── LLM · Local (Ollama) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── LLM · Vercel AI Gateway (opcional, BYOK) ──────────
AI_GATEWAY_API_KEY=

# ── LLM · Claude Max (opcional, via Agent SDK/OAuth) ──
CLAUDE_CODE_OAUTH_TOKEN=

# ── LLM · Groq (opcional, online rápido e barato/grátis) ──
# Chave grátis em https://console.groq.com. API OpenAI-compatible (LPU, 500+ tok/s).
# Ative e os modelos Groq aparecem no seletor de provedor automaticamente.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1  # (padrão; só mude se usar proxy)

# ── LLM · Google Gemini (opcional, tier grátis) ──
# Chave em https://aistudio.google.com/apikey. Endpoint OpenAI-compatible.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  # (padrão)

# ── LLM · OpenAI (opcional) — MESMA chave usada na visão/realtime acima ──
# Se OPENAI_API_KEY estiver setada, os modelos GPT também aparecem no chat.
# OPENAI_BASE_URL=https://api.openai.com/v1  # (padrão)

# ── LLM · Cohere (opcional) ──
# Chave em https://dashboard.cohere.com. Compatibility API (OpenAI-compatible).
COHERE_API_KEY=
# COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1  # (padrão)

# ── Voz tempo real premium (OpenAI Realtime, opcional) ─
# Se presente, habilita o modo ⚡ (conversa por voz S2S de baixa latência).
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# ── Conectores · Google (Gmail + Agenda + login social) ─
# Redirect URI a cadastrar no Google Cloud Console:
#   http://localhost:3000/api/connectors/google/callback   (login social usa /api/auth/callback/google)
# Escopos usados: gmail.modify, calendar, openid, email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Conectores · Notion (opcional) ─────────────────────
# Integração pública em https://www.notion.so/my-integrations
#   Redirect URI: http://localhost:3000/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ── Conectores · Slack (opcional) ──────────────────────
# App em https://api.slack.com/apps  → OAuth & Permissions
#   Redirect URI: http://localhost:3000/api/connectors/slack/callback
#   User scopes: chat:write, channels:read, channels:history
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Conectores · WhatsApp (Cloud API da Meta, opcional) ─
# App em https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Conectores · criptografia dos tokens em repouso ────
# Opcional: se vazio, deriva de BETTER_AUTH_SECRET. Em produção, isole aqui.
CONNECTORS_ENC_KEY=

# ── Voz ──
VOICE_URL=http://localhost:8001
# WebSocket de wake word acessado pelo navegador (não pela rede interna)
VOICE_PUBLIC_WS_URL=ws://localhost:8001
# TTS local (Piper) — voz pt-BR baixada sob demanda
PIPER_VOICE=pt_BR-faber-medium
# Wake word "Ei Órbita" / "Órbita" via Vosk (modelo pt baixado sob demanda)
WAKE_TRIGGER=orbita
WAKE_MIN_CONF=0.7

# ── STT premium (AssemblyAI Universal-3 Pro — recomendado p/ pt-BR) ──
# Quando setado, vira o STT PREFERIDO (WER ~3-4% em pt-BR vs ~7-10% do whisper
# local); sem chave, usa o faster-whisper local. Mesma config da Adalink
# (speech_models: universal-3-pro → universal-2). Pegue a chave em
# https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=

# ── Visão ("ver a tela") ──
# Local: baixe no Ollama (ollama pull moondream OU qwen2.5vl p/ melhor pt-BR).
# Nuvem: se OPENAI_API_KEY setada, usa gpt-4o.
VISION_MODEL=moondream

# ── Storage · Cloudflare R2 (S3-compatible, opcional) ──
# Guarda anexos (imagens do chat, fotos de comprovante, documentos) fora do
# Postgres. Sem isso, imagens vão como data URL (base64) dentro do banco.
# Credenciais em: Cloudflare → R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orbita
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# URL pública do bucket (r2.dev ou domínio próprio), se for servir os arquivos direto
R2_PUBLIC_URL=

# Web Push (VAPID) — notificações push do navegador (proatividade)
# Gere um par com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
