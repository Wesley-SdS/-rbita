# ── Banco ──────────────────────────────────────────────
DATABASE_URL=postgres://orbita:orbita@localhost:5433/orbita

# ── Better Auth ────────────────────────────────────────
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-de-32+chars
BETTER_AUTH_URL=http://localhost:3000

# ── LLM · Local (Ollama) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── LLM · Vercel AI Gateway (opcional, BYOK) ──────────
AI_GATEWAY_API_KEY=

# ── LLM · Claude Max (opcional, via Agent SDK/OAuth) ──
CLAUDE_CODE_OAUTH_TOKEN=

# ── Conectores · Google (Gmail + Agenda + login social) ─
# Redirect URI a cadastrar no Google Cloud Console:
#   http://localhost:3000/api/connectors/google/callback   (login social usa /api/auth/callback/google)
# Escopos usados: gmail.modify, calendar, openid, email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Conectores · Notion (opcional) ─────────────────────
# Integração pública em https://www.notion.so/my-integrations
#   Redirect URI: http://localhost:3000/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ── Conectores · Slack (opcional) ──────────────────────
# App em https://api.slack.com/apps  → OAuth & Permissions
#   Redirect URI: http://localhost:3000/api/connectors/slack/callback
#   User scopes: chat:write, channels:read, channels:history
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Conectores · WhatsApp (Cloud API da Meta, opcional) ─
# App em https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Conectores · criptografia dos tokens em repouso ────
# Opcional: se vazio, deriva de BETTER_AUTH_SECRET. Em produção, isole aqui.
CONNECTORS_ENC_KEY=

# ── Voz ──
VOICE_URL=http://localhost:8001
# WebSocket de wake word acessado pelo navegador (não pela rede interna)
VOICE_PUBLIC_WS_URL=ws://localhost:8001
# TTS local (Piper) — voz pt-BR baixada sob demanda
PIPER_VOICE=pt_BR-faber-medium
# Wake word (openWakeWord) — "hey_jarvis" pré-treinado; treinar "Ei Órbita" é opcional
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
