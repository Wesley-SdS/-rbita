{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "VERCEL", "VERCEL_ENV", "VERCEL_URL"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "//": "O Turborepo isola o ambiente: variáveis NÃO declaradas aqui não chegam ao build (mesmo estando na Vercel). Declare toda env nova também aqui.",
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CONNECTORS_ENC_KEY",
        "OLLAMA_BASE_URL",
        "AI_GATEWAY_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "GROQ_API_KEY",
        "GROQ_BASE_URL",
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GEMINI_BASE_URL",
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "COHERE_API_KEY",
        "COHERE_BASE_URL",
        "ASSEMBLYAI_API_KEY",
        "ASSEMBLYAI_SPEECH_MODELS",
        "REALTIME_MODEL",
        "REALTIME_VOICE",
        "VISION_MODEL",
        "VISION_MODEL_OPENAI",
        "VOICE_URL",
        "VOICE_PUBLIC_WS_URL",
        "PIPER_VOICE",
        "WAKE_TRIGGER",
        "WAKE_MIN_CONF",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "NOTION_CLIENT_ID",
        "NOTION_CLIENT_SECRET",
        "SLACK_CLIENT_ID",
        "SLACK_CLIENT_SECRET",
        "WHATSAPP_TOKEN",
        "WHATSAPP_PHONE_ID",
        "RESEND_API_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT"
      ]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
