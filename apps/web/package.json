    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orbita/llm": "workspace:*",
    "ai": "^7.0.31",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "duck-duck-scrape": "^2.2.7",
    "next": "^16.2.10",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
