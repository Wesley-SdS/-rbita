{
  "manifest_version": 3,
  "name": "Órbita no Chrome",
  "short_name": "Órbita",
  "description": "As mãos da Órbita no seu Chrome: lê e age só dentro da sessão que você aprova, com borda colorida e botão Parar.",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "sidePanel",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Órbita",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "conteudo.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  }
}
